function _conditionalRender() {
#  set -x 
  while read line; do
    if [[ "$line" == '$(' ]]; then # match start of subshell capture
      continue
    elif [[ "${line::2}" =~ \<[a-Z]|\</|\"\<|\'\<  ]]; then # match html element
      line="${line%% }"
	  if [[ ${line: -2} == "&&" ]]; then # skip && for now
        line="${line%%\&\&}"
        @unquote line
        local appendand=true
      else 
          @unquote line
      fi
      output+=" printf '%s' \""
      while read line; do
      [[ "$nextline" ]] && local buf="$line" && line="$nextline" && nextline="$buf" # move line to buffer
        
        if echo "${line## }" | grep -qE '^[[:space:]]*</?([A-Z][a-zA-Z0-9]*)\b'; then # match custom element
          [[ "$line" =~ /\>.* ]] && nextline=$(sed 's|^.*/>\(.*\)|\1|' <<< "$line") && line="${line//$nextline}" 
          line="${line%%\/\>}"
          line="${line%%\>}"
          line="${line##\<}"
          output+="\`$line\`" $'\n' 
        else 
          output+="${line//\"/\\\"}"
        fi
      done < <(echo "$line" | sed 's|\([a-zA-Z0-9|"|\@|\/]\)>|\1>\n|g; s|\(</[^>]*>\)|\n\1|g') # html parser basically
      [[ $appendand == true ]] && output+=$'" &&' && unset appendadd || output+=$'"\n' # add && back
    else 
      output+=" $line"
    fi
  done
  output="${output//$'\n' ||/ ||}"
  output="${output%%)}"$'\n'
# set +x
}

function @error() {
  [[ ${#FUNCNAME[@]} > 1 ]] && echo -n "(${FUNCNAME[1]}) " >&2
  echo "${_red}Error:${_nc} ${@}" >&2
}

function _open_heredoc() {
	if (( ! heredoc_open )); then
		[[ "${output: -1}" != $'\n' ]] && output+=$'\n'
		output+=$'cat <<- __eof\n'
		(( heredoc_open ^= 1 ))
		(( level == 0 )) && level="${saved_level:=2}"
	fi
}

function _close_heredoc() {
	if (( heredoc_open )); then
		[[ "${output: -1}" != $'\n' ]] && output+=$'\n'
		output+=$'__eof\n'
		(( heredoc_open ^= 1 ))
		saved_level="$level"
		level=0
	fi
}

function _render() {
	#set -x
	local dom=false level=2 slevel=0 inscript=false output='' i=0 tag='' indent=''
	local -a parent=() elements=()
	#output+=$'cat <<- __eof\n'
	#heredoc_open=1
	while read -r line; do
  		line="${line%% }"
		line="${line## }"
  		if [[ "$readchunk" ]]; then 
    		if [[ "${line: -1}" != ')' ]]; then
      			chunk+="${line}"$'\n' && continue
    		else 
      			chunk+="${line%%)}"$'\n'
      			line=")"
      			unset readchunk
    		fi
  		fi

		[[ "$line" == '' || "${line::1}" == '#' ]] && continue # skip empty lines or comments
  		#[[ "$line" =~ @render= ]] && @render_type "${line##@render=}" && continue
		case "$line" in
  		"<"*)
			# splits <html>string</html> into
			# <html>
			# string
			# </html>
			# and parses each part separately
			readarray -t elements < <(sed 's|\([a-zA-Z0-9|"|\@|\/]\)>|\1>\n|g; s|\(</[^>]*>\)|\n\1|g' <<< "$line")
    		for line in "${elements[@]}"; do
		      	[[ "$nextline" ]] && local buf="$line" && line="$nextline" && nextline="$buf"
      			[[ "$line" == '' || "${line::1}" == '#' ]] && continue

				# regex if it's a custom element or native html
		      	if grep -qE '^[[:space:]]*</?([A-Z][a-zA-Z0-9]*)\b' <<< "${line## }"; then 
        			[[ "$line" =~ /\>.* ]] && nextline=$(sed 's|^.*/>\(.*\)|\1|' <<< "$line") && line="${line//$nextline}" 
        			line="${line%%\/\>}"
			        line="${line%%\>}"
        			line="${line##\<}" # only keep the function and it's arguments
			        _close_heredoc
					output+="$line"$'\n'
			    else
        			read tag attr <<< "$line"
        			# any lines related to execute() and x-bash-client are made for bash-wasm module which isn't working for now
					case "$tag" in
						*'<script'*)
							slevel=0
							_close_heredoc
							case "$attr" in
								*'bash-client'*)
            						[[ "$type" =~ silent || ! -v bash_wasm_path ]] && inscript=bash-client-silent || inscript=bash-client
            						output+=$'__eof\ncat <<- "_EOF_"\n'
            						[[ ! -v bash_wasm_path ]] && output+="<script>addServerAction(\`" || output+="<script>execute(\`"
									;;
								*'bash'*)	
								# match "<script type=text/x-bash>" blocks
            						if [[ $__render_type == client ]]; then
              							inscript=bash-client
              							output+=$'__eof\ncat <<- "EOF"\n<script>execute(`'
            						else 
              							inscript=bash 
            						fi
									;;
								*)
            						inscript=js
            						output+=$'__eof\ncat <<- "_EOF_"\n'
            						output+="$line"$'\n'
          					esac
							;;
        				*'</script'*)
							slevel=0
          					case "$inscript" in 
            					js)	output+=$'</script>\n_EOF_\n'	;;
            					bash-client-silent)	output+=$'`)</script>\n_EOF_\n'	;;
            					bash-client)
              						read uid </proc/sys/kernel/random/uuid
              						output+="\`,'$uid')</script><div id='$uid'></div>"
              						unset uid
              						output+=$'\n_EOF_\n'
         		 			esac
							_open_heredoc
          					inscript=false
							;;
						'<body'*|'<main'*|'<div'*)
							((level+=2))
							_open_heredoc
							[[ "$inscript" != false ]] && ((++slevel)) #&& echo "i $slevel $tag $line" && set -x
							output+="${line}"$'\n'
          					;;
						'<head'*)
							((level+=2))
    	        			local ismeta=true
							_close_heredoc
							output+=$'fiction.addMeta <<- __eof\n'
							heredoc_open=1
        	  				;;
						'</head>')
							((level-=2))
							output+=$'__eof\n'
							heredoc_open=0
							[[ -v ismeta ]] && unset ismeta
							;;
         				'</'*)
							_open_heredoc
							((level-=2))
							((--slevel)) #&& echo "d $slevel $tag"
							output+="${line}"$'\n'
          					;;
						'<'*'/>')
							output+="$line"$'\n'
							;;
						*)
						_open_heredoc
        				# check if there are special callbacks
          				case "$line" in
	          				on:*)
    	        				line="${line%%\>}";
        	    				line="${line##\<}";
            					local arg attr key events;
            					read el args <<< "$line";
            					if [[ "$args" =~ on:?* ]]; then
									while read arg; do 
              							IFS='=' read key value <<< "${arg}"; 
              							@unquote value
	              						[[ -z "$key" ]] && continue
    	          						case "$key" in
        	        						js-on:*) key="${key//js-on:}"; events+="on${key,,}=\"$($value)\" " ;;
	                						server-on:*) key="${key//on:}"; _events+="on${key,,}=\"\$(addServerAction "$value")\" " ;;
    	        	    					on:*) key="${key//on:}"; _events+="on${key,,}=\"execute(\`$value\`)\" " ;;
        	        						on*)  events+="${key,,}=\"$value\" " ;;
            	    						*)  attr+="$key=\"$value\" "
	              						esac
    	       						done <<< "$args"
        	    					output+="<$el $attr $events>"$'\n'
            						unset el args key events arg
          						fi
								;;
          					*)
								[[ "$inscript" != false && "${line::1}" == '<' ]] && ((++slevel)) #&& echo "i $slevel $tag" && set -x
								output+="$line"
								((level+=2))
          				esac
	        		esac
        			unset tag _
					#output+="printf '%s' \"${line//\"/\\\"}\""$'\n'
      			fi 
    		done
  		# add line without any wrapping in case it's bash/inside js block
  		;;
		# capture subshell execution
		'$('*) 
    		if [[ "${line: -1}" != ')' ]]; then
      			readchunk=true
      			line="${line//\$(/\$($'\n'  }"
      			chunk="${line%%)}"$'\n'
	 	     	continue
		    else
      			line="${line//\$(/\$($'\n'  }"
		      	line="${line%%)}"$'\n)'
      			# pass subshell chunk to conditional renderer
      			if [[ "$__render_type" == client ]]; then 
        			output+=$'cat <<- "_EOF_"\n<script>execute(`'
        			line="${line//&&/&&$'\n'}"
        			_conditionalRender <<<"${line//||/$'\n'||$'\n'}"
        			local uid=$(cat /proc/sys/kernel/random/uuid)
			        output+="\`,'$uid')</script><div id='$uid'></div>" # extra div to redirect output from bash-client block
        			output+=$'\n_EOF_\n'
			        unset uid
			    else
        			line="${line//&&/&$'\n'}"
			        _conditionalRender <<<"${line//||/$'\n'||$'\n'}"
      			fi
    		fi
			;;
		# append chunk in case subshell is multi-line
  		')') 
      		if [[ "$chunk" ]]; then 
				_conditionalRender <<<"${chunk//||/$'\n'||$'\n'})"
			else
				output+="${line}"
			fi
			;;
		'{@children}') 
			_close_heredoc
			output+=$'{@children}\n'
			_open_heredoc 
			;;
		'{'*'}')
			output+="$(sed 's|{\([^[:space:]]\+\)}|<a data-bind="\1"></a>|g' <<< "$line")" # "dynamic" variables manageable by setState
			;;
  		*) 
    		if [[ "$inscript" != false ]]; then
				_close_heredoc
				output+="${line}"
				_open_heredoc
			else
				output+="${line}"$'\n'
			fi
  		esac 
	done
	_close_heredoc
	render_output="$output"
	unset input output level flevel i inscript parent line nextline
} 

bashx() {
	if [ -f "$1" ]; then 
  	# regex for capturing all @return blocks
  		input=$(sed -E 's#(.*)\@return[[:space:]](json|html)[[:space:]]*\{[[[:space:]]*]?(.*)[^^]\}(.*)$#\1\n\@return \2 \{\n\3\n}\n\4#g' "$1" | sed 's/^source.*bashx//g') 

	else 
  		return 1
	fi
	[[ "$BASHX_VERBOSE" ]] && local time=$(date +%s%3N)

	# #NEWLIN#: literal newline ($'\n')
	# #NL#: backslashed newline (\n)
	# for some reason bash doesn't like \n during substitution so we replace it beforehand 
	local out1="${input//$'\n'/#NEWLIN#}"
	out1="${out1//\\n/#NL#}"
	# split @return blocks with $'\r' for further parsing per block
	local out2=$(awk 'function count(s, c) { n=0; for (i=1; i<=length(s); i++) if (substr(s, i, 1) == c) n++; return n } /^[[:space:]]*(@return|@respond)[[:space:]](html|json|[0-9]+|[A-z]+)[[:space:]]*{[[:space:]]*$/ { in_block=1; depth=1; print; next } in_block { o=count($0,"{"); c=count($0,"}"); depth+=o-c; print; if (depth==0) { in_block=0; print "\r" } }' <<< "$input")
	#echo "$out2" 
	#return
	while read -rd $'\r' block; do
  		#echo "${block}"
		#return
  		block1="$block"

  		if [[ "${block:8:4}" == 'html' ]]; then
    		block1="${block1%%\}}"
    		_render "" <<< "${block1/@return html \{}"
    		local newblock=$'{\n'"${render_output}"$'\n}'
			newblock="${newblock//\&/\\\&}"
  		elif [[ "${block:8:4}" == 'json' ]]; then 
  			# remove semicolon, newlines and escape double quotes
    		local newblock="${block/@return json}"
    		newblock="${newblock//\};/\}}"
    		newblock="${newblock//$'\n'/ }"
    		newblock=$(cat <<-eof
echo "${newblock//\"/\\\"}"
eof
)
    		newblock="${newblock//  }"
		elif [[ "${block::8}" == "@respond" ]]; then
			status="${block:9:3}"
			if ! [ "$status" -eq "$status" ] 2>/dev/null; then
				_error "($1) Invalid status code: $status"$'\n'"$block"
				return 1
			fi
			block1="${block1%%\}}"
    		_render "" <<< "${block1/@respond $status \{}"
    		local newblock="FictionResponseHeaders['content-type']='text/html' FictionResponse['status']='$status'"$'\n{\n'"${render_output}"$'\n} > "$WORKER_OUT"; __fiction_responded=1'
			newblock="${newblock//\&/\\\&}"
  		fi
  		newblock="${newblock##$'\n'}"
  		block="${block//$'\n'/#NEWLIN#}"
  		block="${block//\[/\\\[}"
  		block="${block//\]/\\\]}"
		#newblock="${newblock//\\n/#NL#}"
		#out1="${out1//\\n}"
  		out1="${out1//${block//\\n/#NL#}/${newblock% }}"
		#echo "$block"
		#echo "$newblock"
	done <<< "$out2"
	[[ "$BASHX_VERBOSE" ]] && printf "%s\n" "[$_green✓$_nc] Compiled $1 ($(($(date +%s%3N)-time))ms)" 
	unset input out out2 block time block1 render_output
	#echo "${out1//#NEWLIN#/$'\n'}" 
	#return
	if [[ "$2" ]]; then
		out1="${out1//\%AND\%/\&}"
		echo "${out1//#NEWLIN#/$'\n'}" >"$2"
	elif [[ "" ]]; then
			echo "$1:"
  			echo "${out1//#NEWLIN#/$'\n'}" 
  			printf "\n"
	else 
  		BASHX_FILENAME="$(readlink -f "$1")"
  		out1="${out1//\%AND\%/\&}"
  		eval "${out1//#NEWLIN#/$'\n'}"
	fi
	unset out out1 out2 block block1
	#set -x
}

function @parse {
  local _events='' arg
  for arg in "$@"; do
	local _key _value
    IFS='=' read _key _value <<< "${arg}"; 
    case "$_key" in
	  '') continue ;;
      js-on:*)
        _key="${_key//js-on:}"
        _value="${_value##\'}"
        _value="${_value//\'}"
        _events+="on${_key,,}=\"$($_value)\" "
        ;;
      on:*)
        _key="${_key//on:}"
        _value="${_value##\'}"
        _value="${_value//\'}"
        _events+="on${_key,,}='execute('$_value')"
        ;;
      on*)
        _events+="${_key,,}=\"$_value\" "
      ;;
      *) printf -v "$_key" "%s" "$_value"
      esac
  done
}


function @exclude {
  local list="${1}" result=() key value
  for arg in "${@:2}"; do
    IFS='=' read key value <<< "${arg}"; 
    [[ -z "$key" ]] && continue
    printf -v "$key" "%s" "$value"
    [[ "$key" =~ $list ]] && continue 
    result+=("$key='$value'")
  done
  set -- ${result[@]}
}

function @require {
  for arg in $@; do 
    declare -F "$arg" || echo "Error: required $arg is not found" 
  done
}

function @unquote {
 for key in "$@"; do
    local -n key1=$key
    key1="${key1%%\'}"; key1="${key1##\'}"; key1="${key1##\"}"; printf -v "$key" "${key1%%\"}"; 
  done
}

function @wrapper() {
  for key in "$@"; do 
    [ -z "$(declare -F "$key")" ] && return
    eval "$(declare -f "$key" | sed "s+{@children}+}; /${key}() {+g")"
  done
}

function @render_type() {
  case "${1,,}" in
    client) __render_type=client ;;
    server) __render_type=server ;;
         *) @error "Invalid render type provided" && return 1
  esac
}

function @import() {
  # Syntax: import <filename>  || import <filename> as <ElementAlias>
  # import <function> from <filename> || import <function> from <filename> as <ElementAlias>
  local name filename
  [ -z "$name" ] && name="$1"
  shift
  if [[ "$1" == "as" ]]; then
    if [ -d "$name" ]; then 
      name="$name/index.sh"
    elif [ ! -f "$name" ]; then
      echo "$name not found to import."
      exit 1
    fi
    shift
    if [ -z "$1" ]; then
      fn_name=""${name%.*}""
    else
      fn_name="$1"
    fi
    eval "${fn_name}() { $(cat "$name") }"
  elif [[ "$1" == "from" ]]; then
    shift
    filename="$1"
    if [ ! -f "$filename" ]; then
      error "$name not found to import."
      exit 1
    fi
    [[ "$filename" =~ .shx|.bashx ]] && local funcout="$(bashx "$filename" && declare -f "$name" && declare -f "/$name")" || local funcout="$(. "$filename" && declare -f "$name")"
    [ -z "$funcout" ] && error "$name is not found in $filename" && return 1
    shift
    if [[ "$1" == "as" ]]; then
      shift
      if [ -z "$1" ]; then
        fn_name="${name%.*}"
      else
        fn_name="$1"
      fi
      eval "${funcout/$name/$fn_name}"
    else
      [[ "$funcout" ]] && eval "$funcout"
    fi
  else 
    [[ -n "$name" ]] && { [[ "$name" =~ .shx|.bashx ]] && bashx "$name" || source "$name"; }
  fi
}

declare -F exportFunction >/dev/null && exportFunction @require @unquote @parse @exclude

