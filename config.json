{
    "server": {
        "core": "socat",
        "address": "0.0.0.0",
        "port": 8080,
        "compression": true,
        "allowed_hostnames": [],
        "ssl": {
            "enabled": false,
            "key": "",
            "cert": ""
        }
    },
    "logs": {
        "timestamp": true,
        "address": true,
        "request_headers": true,
        "response": true
    },
    "body": {
        "application/json": {
            "parse": true,
            "trim": true,
            "raw": true
        }
    },
    "plugins": [
        "tailwindcss"
    ]
}